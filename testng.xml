<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="NDC FlightSearch API Suite" parallel="classes" thread-count="2" verbose="1">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <test name="FlightSearch - Positive">
        <classes>
            <class name="com.tildetech.ndc.automation.tests.FlightSearchPositiveTests"/>
        </classes>
    </test>

    <test name="FlightSearch - Negative">
        <classes>
            <class name="com.tildetech.ndc.automation.tests.FlightSearchNegativeTests"/>
        </classes>
    </test>

</suite>
